[org.kde.kcm.efiboot]
Name=EFI Boot
Description=Manage EFI boot entries
Icon=computer

[org.kde.kcm.efiboot.setdefault]
Name=Set default EFI boot entry
Description=Change EFI boot order to make a selected entry default
Policy=auth_admin_keep

[org.kde.kcm.efiboot.rebootto]
Name=Reboot to EFI boot entry
Description=Set BootNext and reboot the system into the selected entry
Policy=auth_admin_keep

